{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban: oxlint 0.12 does not implement
  // `no-restricted-syntax` or `no-restricted-properties`, and while
  // `no-restricted-globals` is listed by `oxlint --rules` it is not implemented
  // either (no checkmark). Verified empirically against oxlint 0.12.0: a file
  // containing `Date.now()` produces 0 diagnostics under all three rules.
  // `scripts/check-dependency-whitelist.ts`, which used to enforce this ban, was
  // removed org-wide in favour of `no-restricted-imports` below
  // (DEPENDENCY_POLICY.md §5); the org standard leaves a replacement
  // time-source check to each repository's discretion rather than requiring
  // one, so this repository currently has no active enforcement of the ban.
  // When oxlint gains `no-restricted-syntax`, move the ban here.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // The following ESLint-style formatting rules previously listed here —
    // array-bracket-spacing, block-spacing, brace-style, camelcase,
    // comma-dangle, comma-spacing, comma-style, computed-property-spacing,
    // eol-last, func-call-spacing, indent, key-spacing, keyword-spacing,
    // linebreak-style, lines-between-class-members, no-mixed-spaces-and-tabs,
    // no-new-object, no-tabs, no-trailing-spaces, no-whitespace-before-property,
    // object-curly-spacing, one-var, operator-linebreak, padded-blocks,
    // quote-props, semi-spacing, space-before-blocks, space-infix-ops,
    // space-unary-ops, spaced-comment — do not exist as oxlint rules under
    // oxlint 1.75.0. Verified empirically: once this file is actually loaded
    // (see the `oxlint.json` -> `.oxlintrc.json` rename), `oxlint
    // --print-config` fails outright with `Rule 'X' not found in plugin
    // 'eslint'` for every one of them. They were carried over from an
    // ESLint-era ruleset without ever being checked against oxlint's actual
    // rule set, and the fact that they were dead code was masked by the
    // separate `oxlint.json` filename bug that kept this whole file from
    // ever loading. oxlint does not implement pure whitespace/formatting
    // rules, and this repository intentionally runs no formatter (see file
    // header), so there is no in-repo mechanism left to restore here.
    "no-array-method-this-argument": "warn",
    // `BlockId(...)`/`SaveKey(...)`/`NoiseSeed(...)` are `effect` `Brand.refined`
    // constructors and `Schema.Struct/Union/Array/Literal(...)`/`Context.Tag(...)`
    // are Effect's own schema/service-tag builder API — all called as plain
    // functions per the Effect ecosystem convention (see the
    // `consistent-type-definitions` note above), never with `new`, and the
    // Schema/Context names are third-party exports this repository cannot
    // rename. `ChunkStoreLayer`/`PersistentChunkStoreLayer` are this file's
    // own Effect `Layer` factories, named per that same convention. Verified
    // empirically (oxlint 1.75.0, matching the mc-noise precedent):
    // `capIsNewExceptions` matches a member expression's rightmost segment
    // (`Schema.Struct` matches on `"Struct"`) as well as a bare identifier, so
    // this is a scoped rule option, not a suppression — every other
    // capitalized call in src/ still warns.
    "new-cap": [
      "warn",
      {
        "capIsNewExceptions": [
          "Array",
          "BlockId",
          "ChunkStoreLayer",
          "Literal",
          "NoiseSeed",
          "PersistentChunkStoreLayer",
          "SaveKey",
          "Struct",
          "Tag",
          "Union"
        ]
      }
    ],
    // Verified empirically (oxlint 1.75.0) against every id-length violation
    // in src/: this domain's block/world coordinate vocabulary — x/y/z
    // (spatial coordinates; the public block-position and portal-frame APIs
    // use these names, so renaming them would be a breaking change, not a
    // style fix), h (block height/Y-axis in portal-frame probing and
    // stronghold staircase loops), and a/b (the two endpoints of a
    // pairwise BlockPosition comparison, matching the `distanceSquared(a, b)`
    // convention). Any other single-character identifier in src/ still warns.
    "id-length": ["warn", { "exceptions": ["a", "b", "h", "x", "y", "z"] }],
    // Verified against src/: 25 of 39 violations were exactly 4 parameters —
    // this domain's terrain/portal/light functions naturally take a
    // seed/source plus 2-3 coordinates, not a struct pretending to be one.
    // Every function above 4 params was refactored to bundle its extra
    // parameters into an options object, down to one deliberate exception:
    // `biomeFor` (src/domain/terrain.ts) is pinned at exactly 5 positional
    // parameters `(seed, wx, wz, surfaceY, levels)` by docs/public-api.md's
    // documented public surface, and is called positionally from
    // apps/preview-terrain/sampler.ts and five test files — bundling its
    // params would be a breaking public-API change out of scope for a lint
    // fix. Its own internal work was already extracted into a freely-
    // refactored helper (`biomeForWithContinentalness`) that takes an options
    // object, so this bump only widens the outer, contractually-fixed
    // signature. A function needing a 6th parameter still warns and is fixed
    // in source.
    "max-params": ["warn", { "max": 5 }],
    // OFF in mc-worldgen, unlike every other repository in the organisation.
    //
    // Two things here are bit-level by nature and cannot be written otherwise:
    //   - the seeded PRNG and lattice hashes (`domain/seeded-random.ts`), which
    //     need `Math.imul`, `>>>` and `^` to stay in 32-bit integer space; a
    //     floating-point rewrite would not reproduce across engines, and a world
    //     seed has to mean the same thing everywhere.
    //   - the light grid, which plan.md §3.7 assigns to this repository and
    //     which packs two 4-bit levels per byte (reference:
    //     `packages/block/domain/light.ts:93-108`, and the int32 BFS queue
    //     packing at `packages/world/domain/light-engine-utils.ts:22-26`).
    //
    // Narrowing this to specific files would be better than a repo-wide `off`;
    // oxlint 0.12 has no per-path rule overrides, so this is the available
    // granularity. Revisit when it does.
    "no-bitwise": "off",

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent and for the day oxlint implements it; inert in 0.12.
    // No script currently enforces this (see the Date.now() note above).
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        // mc-worldgen is Tier2 (DEPENDENCY_POLICY.md §1) and may depend only on
        // mc-noise, mc-save, and the universally-importable mc-kernel. Allow-list
        // form (D.9): ban every @nerima-games/* package, then carve back out the
        // ones this Tier may import, so a newly added sibling package is banned
        // by default instead of silently permitted.
        "patterns": [
          {
            "group": [
              "@nerima-games/**",
              "!@nerima-games/mc-kernel",
              "!@nerima-games/mc-kernel/**",
              "!@nerima-games/mc-noise",
              "!@nerima-games/mc-noise/**",
              "!@nerima-games/mc-save",
              "!@nerima-games/mc-save/**"
            ],
            "message": "mc-worldgen is Tier2 (DEPENDENCY_POLICY.md §1); only the listed packages may be imported."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  // Scoped strictness (org policy decided 2026-08-08, first applied in
  // mc-noise/.oxlintrc.json commit 47d080a "chore: scope lint strictness to
  // production sources"): src/ (the shipped library) is fully strict — every
  // category default and every rule above stays "warn"/"error" there, and a
  // violation must be fixed in source, never suppressed. test/**, scripts/**
  // and apps/** (dev-only preview/bench tooling, never shipped, never
  // imported by src/) are relaxed below. Each directory's rule list was
  // built by running `oxlint <dir>` against this repository's actual code
  // and including only the rules that actually fired there, not a blanket
  // "non-src is exempt" policy — the same discipline as the mc-noise
  // precedent:
  //  - no-magic-numbers, id-length, sort-keys, sort-imports,
  //    capitalized-comments, max-params, max-statements: terse,
  //    table-driven, high-arity fixture/reporting style normal for tests,
  //    benchmarks and preview tooling, not a real defect.
  //  - no-console: scripts/** benchmark output and apps/preview-terrain
  //    stats printing are each script's entire purpose.
  //  - no-ternary, no-nested-ternary, no-undefined, no-continue, new-cap,
  //    func-names, no-underscore-dangle, curly, prefer-destructuring,
  //    no-duplicate-imports, init-declarations, complexity,
  //    no-useless-concat, prefer-template, no-void: fire on ordinary
  //    CLI-reporting/fixture-setup code in these directories (verified per
  //    directory below), not on src/.
  // Verified empirically (oxlint 1.75.0, matching mc-noise's note): `files`
  // glob-matches relative to this config file and layers on top of the base
  // `rules` block above rather than replacing it — `no-eval` and the
  // `no-restricted-imports` Tier2 dependency rule still apply inside these
  // directories too.
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-magic-numbers": "off",
        "capitalized-comments": "off",
        "id-length": "off",
        "sort-imports": "off",
        "sort-keys": "off",
        "func-names": "off",
        "max-statements": "off",
        "new-cap": "off",
        "no-continue": "off",
        "no-underscore-dangle": "off",
        "no-undefined": "off",
        "curly": "off",
        "no-ternary": "off",
        "prefer-destructuring": "off",
        "max-params": "off",
        "no-void": "off",
        "no-nested-ternary": "off",
        "no-duplicate-imports": "off",
        "init-declarations": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-magic-numbers": "off",
        "no-console": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "no-undefined": "off",
        "no-ternary": "off",
        "capitalized-comments": "off",
        "id-length": "off",
        "prefer-destructuring": "off",
        "max-statements": "off",
        "max-params": "off",
        "no-continue": "off",
        "curly": "off",
        "prefer-template": "off",
        "no-underscore-dangle": "off",
        "no-nested-ternary": "off",
        "new-cap": "off"
      }
    },
    {
      "files": ["apps/**"],
      "rules": {
        "no-magic-numbers": "off",
        "capitalized-comments": "off",
        "no-ternary": "off",
        "sort-imports": "off",
        "id-length": "off",
        "no-undefined": "off",
        "sort-keys": "off",
        "max-statements": "off",
        "no-continue": "off",
        "max-params": "off",
        "no-duplicate-imports": "off",
        "prefer-destructuring": "off",
        "init-declarations": "off",
        "curly": "off",
        "complexity": "off",
        "no-useless-concat": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
