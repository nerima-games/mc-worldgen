{
  // Shipped source only. `types: []` (inherited) is deliberate: if a Node type
  // ever leaks into domain code this project fails, which is what keeps world
  // generation runnable inside a Web Worker as well as in Node.
  "extends": "./tsconfig.base.json",
  "include": ["src/index.ts", "src/domain/**/*.ts", "src/application/**/*.ts"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "test/**",
    "scripts/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
