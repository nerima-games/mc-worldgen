{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM, no WebWorker, no Node globals.
    //
    // This is load-bearing, not hygiene. The reference implementation's
    // `packages/world` imports THREE.js zero times (verified — see
    // docs/design-notes.md), and that separation is the reason world generation
    // can run in a worker, in Node, and in a test with no canvas. `lib` without
    // "DOM" makes a regression mechanically impossible rather than merely
    // discouraged: `new THREE.Vector3()` would not typecheck here.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBuiltinIteratorReturn": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Public declarations must be derivable from each source file's explicit
    // annotations. This prevents an implementation-only inference change from
    // silently changing the package API.
    "isolatedDeclarations": true,
    // A type-only import must say so. The emitted JavaScript then follows from
    // the import statement alone, with no whole-program analysis deciding which
    // specifiers survive — which is what a package shipping ESM to its
    // consumers wants.
    "verbatimModuleSyntax": true,
    // Nothing that needs a runtime transform to have meaning: no enum, no
    // namespace, no parameter property. The domain is types and const data
    // already, so this pins the property rather than requesting a change.
    "erasableSyntaxOnly": true,
    // A side-effect import that resolves to nothing is an error, not a no-op.
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // Repository checks are intentionally no-emit. `tsconfig.release.json` is
    // the sole emitting configuration, so source imports stay type-safe while
    // the published package exposes only generated JavaScript and declarations.
    "noEmit": true,

  }
}
