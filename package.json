{
  "name": "@nerima-games/mc-worldgen",
  "version": "0.5.0",
  "type": "module",
  "description": "World generation for the nerima-games Minecraft-clone rebuild: biome classification, deterministic terrain, carvers, vegetation, structures, chunk lifecycle and the light grid. No renderer, ever.",
  "homepage": "https://github.com/nerima-games/mc-worldgen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-worldgen.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-worldgen/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "worldgen",
    "terrain",
    "biome"
  ],
  "scripts": {
    "bench": "tsx scripts/bench-terrain.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "goldens:update": "tsx scripts/update-goldens.ts",
    "lint": "oxlint --deny-warnings src apps scripts test && ast-grep scan",
    "lint:fix": "oxlint --fix src apps scripts test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "preview": "tsx apps/preview-terrain/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:repro": "tsx scripts/verify-reproducibility.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:repro"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.9.0",
    "@nerima-games/mc-noise": "0.5.0",
    "@nerima-games/mc-save": "0.6.0",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/vitest": "4.0.5",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.42.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
